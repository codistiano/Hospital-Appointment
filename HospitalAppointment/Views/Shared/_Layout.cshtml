<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hospital Appointment EDA</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <style>
        body { background: #f6f8fb; }
        .navbar-brand { font-weight: 600; }
        .event-pill { font-family: monospace; font-size: 0.8rem; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">🏥 Hospital EDA</a>
        <div>
            <a class="nav-link d-inline-block text-white" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a class="nav-link d-inline-block text-white" asp-controller="Appointment" asp-action="Index">Appointments</a>
            <a class="nav-link d-inline-block text-white" asp-controller="Appointment" asp-action="Create">+ New</a>
        </div>
    </div>
</nav>

<main class="container">
    @if (TempData["Success"] is string s)  { <div class="alert alert-success">@s</div> }
    @if (TempData["Error"]   is string er) { <div class="alert alert-danger">@er</div> }
    @RenderBody()
</main>

<footer class="container text-center text-muted my-5 small">
    Event-Driven Programming Project · ASP.NET Core 8 · @DateTime.Now.Year
</footer>
</body>
</html>
