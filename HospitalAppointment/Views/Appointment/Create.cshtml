@{ ViewData["Title"] = "New Appointment"; }
@{
    var patients = ViewBag.Patients as IReadOnlyList<HospitalAppointment.Models.Patient>;
    var doctors  = ViewBag.Doctors  as IReadOnlyList<HospitalAppointment.Models.Doctor>;
}

<h1>Schedule New Appointment</h1>
<p class="text-muted">Submitting will publish an <code>AppointmentScheduledEvent</code> handled by the Email + Audit-Log consumers.</p>

<form asp-action="Create" method="post" class="card card-body">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Patient</label>
        <select name="patientId" class="form-select" required>
            <option value="">— select —</option>
            @foreach (var p in patients!) { <option value="@p.Id">@p.FullName (@p.Email)</option> }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Doctor</label>
        <select name="doctorId" class="form-select" required>
            <option value="">— select —</option>
            @foreach (var d in doctors!) { <option value="@d.Id">@d.FullName — @d.Specialization</option> }
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Scheduled For</label>
        <input type="datetime-local" name="scheduledFor" class="form-control" required
               value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:mm")" />
    </div>
    <div class="mb-3">
        <label class="form-label">Reason</label>
        <input type="text" name="reason" class="form-control" placeholder="e.g. Annual check-up" />
    </div>
    <div>
        <button class="btn btn-primary">Schedule</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>
